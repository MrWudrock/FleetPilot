{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node generate-config.js",
  "outputDirectory": ".",
  "installCommand": "",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.fleetpilot.ru" }],
      "destination": "https://fleetpilot.ru/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/wireframes", "destination": "/wireframes/index.html" },
    { "source": "/pitch-deck", "destination": "/pitch-deck.html" },
    { "source": "/deck", "destination": "/pitch-deck.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
